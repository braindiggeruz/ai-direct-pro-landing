{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM", "WebWorker"],
    "module": "esnext",
    "types": ["@cloudflare/workers-types"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "files": [
    "index.ts",
    "bridge-mailbox.ts",
    "bridge-protocol.ts",
    "configuration.ts",
    "crypto.ts",
    "message-effect.ts",
    "protocol.ts",
    "timeouts.ts"
  ]
}
