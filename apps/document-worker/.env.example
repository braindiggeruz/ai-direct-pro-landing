DOCUMENT_API_BASE_URL=https://gptbot.uz
# Set the same random secret in Railway and Cloudflare. Do not commit its value.
DOCUMENT_WORKER_SECRET=
DOCUMENT_API_ALLOWED_HOSTS=gptbot.uz,www.gptbot.uz
DOCUMENT_POLL_SECONDS=20
DOCUMENT_JOB_TIMEOUT_SECONDS=90
DOCUMENT_SHUTDOWN_SECONDS=25
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=45
RAILWAY_DEPLOYMENT_OVERLAP_SECONDS=0
PORT=3000
# Local verification only; Docker uses its bundled Chromium.
# DOCUMENT_CHROMIUM_EXECUTABLE=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
