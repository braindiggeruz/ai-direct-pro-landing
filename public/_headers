# Cloudflare Pages edge response headers.
# Applied to every response. Docs: https://developers.cloudflare.com/pages/configuration/headers/
#
# Security baseline added 2026-06-26 to fix missing HSTS / X-Frame-Options /
# CSP / nosniff flagged by SEO audit (60 critical security findings).
#
# NOTE on CSP: the site loads GTM, GA, Meta Pixel, Yandex Metrika and inline
# bootstrap scripts. The allowlist below is enforced and limited to the exact
# observed services. Metrika contributes one origin — https://mc.yandex.ru — to
# script-src, connect-src and frame-src; the noscript pixel is covered by the
# existing `img-src https:`.
#
# This file is the /public fallback; dist/_headers is regenerated by
# scripts/generate-robots.ts and must say the same thing.

/*
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net https://challenges.cloudflare.com https://static.cloudflareinsights.com https://mc.yandex.ru; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https: blob:; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://analytics.google.com https://region1.analytics.google.com https://stats.g.doubleclick.net https://www.google.com https://www.googletagmanager.com https://connect.facebook.net https://www.facebook.com https://cloudflareinsights.com https://static.cloudflareinsights.com https://mc.yandex.ru https://ov-1d104299d2a447049cdc73700c9309f7.ecs.us-west-2.on.aws https://*.run.app https://*.ecs.us-east-1.on.aws; frame-src 'self' https://www.googletagmanager.com https://td.doubleclick.net https://challenges.cloudflare.com https://www.facebook.com https://mc.yandex.ru; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://www.facebook.com; object-src 'none'; upgrade-insecure-requests

# Bormi Admin (owner control center): the shell's headers are NOT here.
# `_headers` merges matching blocks instead of letting the specific one win, so
# a /admin/* block would be appended to the global one above and produce a
# self-contradicting Cache-Control and a malformed X-Frame-Options.
# functions/admin/[[path]].ts serves the shell and sets its own headers.
#
# What stays here is the one path that Function does not handle: the panel's
# hashed chunks, excluded in _routes.json and served from the asset store.
/admin/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

# Long-cache immutable build assets (hashed filenames).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
