  "faq": [
    {
      "q": "2027-yilda 1-yanvar haftaning qaysi kuni?",
      "a": "1-yanvar juma kuniga to‘g‘ri keladi. Yil 31-dekabr, juma kuni tugaydi. 2027 kabisa yil emas: fevralda 28 kun, butun yilda 365 kun."
    },
    {
      "q": "2027-yilda qaysi bayram kunlari ishlanmaydi?",
      "a": "Mehnat kodeksining 208-moddasiga ko‘ra sanasi qat’iy bayramlar: 1-yanvar, 8-mart, 21-mart, 9-may, 1-sentabr, 1-oktabr va 8-dekabr. Bundan tashqari Ro‘za hayit va Qurbon hayitning birinchi kunlari ham ishlanmaydi, ammo 2027-yilgi sanalari 2026-yil 17-noyabr holatiga ko‘ra e’lon qilinmagan."
    },
    {
      "q": "Ramazon hayiti 2027-yilda qachon?",
      "a": "Aniq sana hozircha rasmiy e’lon qilinmagan, shuning uchun bu sahifada yozilmagan. Sana Prezident qarori bilan e’lon qilinadi; president.uz, lex.uz va O‘zbekiston musulmonlari idorasi e’lonlarini kuzating."
    },
    {
      "q": "Qurbon hayiti 2027-yilda qachon?",
      "a": "Ramazon hayiti kabi, bu sana ham 2026-yil 17-noyabrda rasmiy e’lon qilinmagan edi. Qo‘shimcha dam olish kunlari va ko‘chirishlar alohida farmon bilan belgilanadi; hujjat chiqqach sahifa yangilanadi."
    },
    {
      "q": "21-mart va 9-may yakshanbaga to‘g‘ri kelsa, dam olish kuni qanday bo‘ladi?",
      "a": "Mehnat kodeksiga ko‘ra dam olish kuni bayramdan keyingi ish kuniga ko‘chiriladi: besh kunlik haftada 22-mart va 10-may, ikkalasi dushanba. To‘xtatib bo‘lmaydigan ishlarda ko‘chirilmaydi, Prezident farmoni esa boshqacha belgilashi mumkin."
    },
    {
      "q": "2027-yilda nechta ish kuni bor?",
      "a": "Dushanbadan jumagacha 261 kun bor. Sanasi qat’iy 5 ta bayram shu kunlarga tushadi, shuning uchun dastlabki hisob 256 ish kunini beradi; 22-mart va 10-mayga ko‘chirishlar bilan 254. Hayit kunlari va farmon bilan belgilanadigan kunlar hisobga olinmagan, shuning uchun raqam yakuniy emas."
    },
    {
      "q": "Hafta raqamlari qaysi standartda?",
      "a": "ISO 8601: hafta dushanbadan boshlanadi, yilning 1-haftasi birinchi payshanba bor hafta. 2027-yilda 1-hafta 4-yanvarda boshlanadi, yil 52-hafta bilan tugaydi."
    }
  ],
