# Verbatim copies of Uzum Bank's public API specifications (docs/paid-chat/UZUM-RU.md).
# Their Markdown ends lines with two spaces as hard breaks; keep the files byte-identical
# to the published source instead of reporting that as a whitespace error.
docs/paid-chat/uzum-spec/*.yaml -whitespace

# Studio pragmas and reviewed text use stable LF on Windows.
apps/studio/scripts/device-check.ts text eol=lf
migrations/0076_studio_operations.sql text eol=lf
apps/studio/scripts/studio-page.ts text eol=lf
apps/studio/src/tools/presentation/InAppNotice.tsx text eol=lf
apps/studio/src/tools/presentation/texts.ts text eol=lf
content/studio/pages/uz/taqdimot-ai.json text eol=lf

migrations/0077_studio_shared_click.sql text eol=lf
src/gpt-chat/premium.css text eol=lf

# Ready config patches (docs/paid-chat/MODEL-CLIFF-1712-RU.md): git apply needs them byte-exact with LF.
docs/paid-chat/patches/*.patch text eol=lf

# OpenAI product feed (scripts/build-openai-feed.ts): the build compares these
# byte for byte, so they keep LF on Windows; the .gz is binary.
public/openai-product-feed.jsonl text eol=lf
public/openai-product-feed.tsv text eol=lf
public/openai-product-feed.jsonl.gz binary
scripts/openai-feed-images.json text eol=lf
